<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <!-- These upstream diagnostics remain visible and are checked by exact origin
         in the native verification script; no warning category is suppressed. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2091;IL3000</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DrillPress.RuleAuthoring/DrillPress.RuleAuthoring.csproj" />
    <ProjectReference Include="../../src/DrillPress.Engine/DrillPress.Engine.csproj" />
  </ItemGroup>
</Project>
